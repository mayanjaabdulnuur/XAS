# Render PostgreSQL connection string in production (use the "External
# Database URL" or internal one if the app and DB are in the same Render
# region/project). Locally in Termux, this points at your local Postgres
# instead, e.g.: postgresql://localhost:5432/xtream
DATABASE_URL="postgresql://user:password@host:5432/xtream?schema=public"

# NextAuth
NEXTAUTH_URL="https://your-app.onrender.com"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (Continue with Google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email: verification codes, password reset)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="XAS <no-reply@yourdomain.com>"

# Twilio Verify (admin phone OTP only)
# Twilio (admin phone OTP delivery only — the code itself is generated,
# hashed, and verified by XAS's own code, same pattern as password-reset
# codes; Twilio just sends the SMS, via its plain Messages API)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Persistent disk mount path for uploaded documents/images.
# - Local/Termux dev: leave this UNSET (or comment it out) — it defaults
#   automatically to ./data/uploads inside the project folder, no mounted
#   disk required.
# - Render production: set this explicitly to /data/xas-uploads, and attach
#   a Render Persistent Disk mounted at /data (see README's Render section).
# FILE_STORAGE_ROOT="/data/xas-uploads"

# WhatsApp admin contact fallback if not yet set in Site Settings table
DEFAULT_WHATSAPP_NUMBER=""

# Premium code hashing (Phase 5). Falls back to NEXTAUTH_SECRET if unset,
# but a dedicated secret means rotating one doesn't invalidate the other.
PREMIUM_CODE_HASH_SECRET="generate-with-openssl-rand-base64-32"
